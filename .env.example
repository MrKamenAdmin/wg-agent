# gRPC server port
AGENT_GRPC_PORT=9090

# TLS certificates for mTLS
AGENT_TLS_CERT=/etc/wg-agent/server.crt
AGENT_TLS_KEY=/etc/wg-agent/server.key
AGENT_TLS_CA=/etc/wg-agent/ca.crt

# WireGuard configuration
AGENT_WG_CONFIG_DIR=/etc/wireguard
AGENT_BACKUP_DIR=/var/lib/wg-agent/backups

# Allowed interfaces (comma-separated, empty = all)
AGENT_ALLOWED_INTERFACES=

# Backup retention in days
AGENT_BACKUP_RETENTION_DAYS=7

# dnsmasq bypass.conf integration (optional)
# If set, the orchestrator UI and Telegram bot can edit this file and will run
# `systemctl restart dnsmasq` / `ipset flush <name>` on behalf of the user.
# Leave unset to disable the feature on this agent.
#AGENT_DNSMASQ_BYPASS_CONF=/etc/dnsmasq.d/bypass.conf
#AGENT_DNSMASQ_IPSET_NAME=bypass_vpn

# Optional command prefix for systemctl/ipset — used to escape out of a
# container into the host namespaces. Requires pid:host and privileged:true.
# Leave empty if the agent runs directly on the host.
#AGENT_DNSMASQ_CMD_PREFIX=nsenter -t 1 -a --
